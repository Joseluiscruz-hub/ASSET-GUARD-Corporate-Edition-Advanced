{
  "name": "asset-guard-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Firebase Functions for AssetGuard Gemini 2.5 Flash backend",
  "type": "module",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google/genai": "3.5.0",
    "firebase-admin": "14.5.1",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.5.4"
  }
}
